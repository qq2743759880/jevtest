{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "routing-policy-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "offline",
        "live"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "run_purpose": {
      "enum": [
        "demo",
        "advisory",
        "synthetic_eval",
        "real_exploratory",
        "formal_eval"
      ],
      "title": "Run Purpose",
      "type": "string"
    },
    "basis": {
      "enum": [
        "fixed_rule",
        "demo",
        "synthetic_preview",
        "formal_calibrated"
      ],
      "title": "Basis",
      "type": "string"
    },
    "allowed_stages": {
      "items": {
        "enum": [
          "rule",
          "jev",
          "llm",
          "human"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Stages",
      "type": "array"
    },
    "direct_output_rule_ids": {
      "items": {
        "type": "string"
      },
      "title": "Direct Output Rule Ids",
      "type": "array"
    },
    "jev_high_threshold": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Jev High Threshold"
    },
    "jev_escalate_threshold": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Jev Escalate Threshold"
    },
    "max_total_attempts": {
      "minimum": 1,
      "title": "Max Total Attempts",
      "type": "integer"
    },
    "deadline_ms": {
      "exclusiveMinimum": 0,
      "title": "Deadline Ms",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "execution_mode",
    "run_purpose",
    "basis",
    "allowed_stages",
    "direct_output_rule_ids",
    "max_total_attempts",
    "deadline_ms"
  ],
  "title": "RoutingPolicyV1",
  "type": "object"
}
