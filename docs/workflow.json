  "cards": [
    {
      "dot": "cyan",
      "title": "固定的离线演示策略",
      "items": [
        "Rule → Jev mock → LLM stub；不是供应商效果证明。",
        "可调用：阶段被策略允许且仍有预算、未过期限。",
        "高阈值 0.9 来自默认 offline-demo 策略。"
      ]
    },
    {
      "dot": "rose",
      "title": "错误与结果语义",
      "items": [
        "规则/模型失败不满足直出条件，继续允许的后续阶段。",
        "单阶段失败或预算/超时会标记 degraded。",
        "完全无结果才用 UNKNOWN / HUMAN_TRIAGE；已有有效结果保留。",
        "保存待审后进入另一张人工审核生命周期图。",
        "多个保存节点是不同结果路径，均写入同一应用 SQLite，不是多个数据库。"
      ]
